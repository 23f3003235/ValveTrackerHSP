PORT=3000
DATA_DIR=./data
ADMIN_USER=admin
ADMIN_PASSWORD=          # first start only; if empty a random one is printed in the log
SESSION_DAYS=7
MAX_UPLOAD_MB=25
TRUST_PROXY=0            # 1 when behind a reverse proxy
COOKIE_SECURE=0          # 1 to force Secure cookies (auto when proxy sends X-Forwarded-Proto: https)
